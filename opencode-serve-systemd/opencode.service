[Unit]
Description=OpenCode Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=you
WorkingDirectory=/home/you

# --- resources ---------------------------------------------------------------
# `opencode serve` is one Bun/Node process driving a single event loop, but it
# fans out to LSP / codegraph / agent child processes. A small CPU quota
# starves that loop and stretches any synchronous SQLite work into minutes.
# 400% = 4 of 8 cores.
CPUQuota=400%
CPUShares=2048

# --- self-healing ------------------------------------------------------------
# Bring the service back after a crash or OOM kill. NOTE: this does NOT cover a
# *hang* -- if the event loop gets stuck the process stays alive, so Restart=
# never fires. A wedged server is handled by the health probe (see README).
Restart=always
RestartSec=5

# A hung process ignores SIGTERM; don't wait the default 90s for it.
TimeoutStopSec=60
SendSIGKILL=yes
KillMode=control-group

# Many concurrent request streams + LSP child processes.
LimitNOFILE=65536

NoNewPrivileges=true

# systemd 219 (CentOS 7) does not know these directives: it ignores them and
# logs "Failed to parse protect system value, ignoring". Uncomment only on
# systemd >= 232.
#ProtectSystem=strict
#ProtectHome=read-write
#ReadWritePaths=/home/you /tmp/opencode

# --- environment -------------------------------------------------------------
# `opencode serve` requires a password; keep the real value OUT of this repo.
# Either edit this line, or override it with a drop-in / EnvironmentFile.
# See README.md -> "Set the server password".
Environment=OPENCODE_SERVER_PASSWORD=CHANGE_ME
Environment=HOME=/home/you
Environment=BUN_INSTALL=/home/you/.bun
Environment=NPM_CONFIG_PREFIX=/home/you/.local
# Machine-specific toolchain paths -- adjust for your host.
Environment=PATH=/home/you/tools/maven/bin:/usr/lib/jvm/jdk-21/bin:/home/you/.bun/bin:/home/you/.local/bin:/usr/bin:/bin
Environment=JAVA_HOME=/usr/lib/jvm/jdk-21
Environment=MAVEN_HOME=/home/you/tools/maven

ExecStart=/home/you/.opencode/bin/opencode serve --port 4096 --hostname 0.0.0.0 --mdns-domain example

[Install]
WantedBy=multi-user.target
